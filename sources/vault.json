[
 {
  "id": "debian_live",
  "name": "Debian live",
  "detect": [
   [
    "live/vmlinuz",
    "live/initrd.img"
   ]
  ],
  "kernel": "live/vmlinuz",
  "initrd": "live/initrd.img",
  "options": "boot=live components findiso={path}"
 },
 {
  "id": "ubuntu",
  "name": "Ubuntu",
  "detect": [
   [
    "casper/vmlinuz",
    "casper/initrd"
   ]
  ],
  "kernel": "casper/vmlinuz",
  "initrd": "casper/initrd",
  "options": "bonk.offset={offset} ---",
  "location": true,
  "initrd_extra": "newc:scripts/casper-premount/20iso_scan:{bonk}/casper/20iso_scan"
 },
 {
  "id": "arch",
  "name": "Arch Linux",
  "detect": [
   [
    "arch/boot/x86_64/vmlinuz-linux",
    "arch/boot/x86_64/initramfs-linux.img"
   ]
  ],
  "kernel": "arch/boot/x86_64/vmlinuz-linux",
  "initrd": "arch/boot/x86_64/initramfs-linux.img",
  "options": "archisobasedir=arch img_label={vault} img_loop={path}"
 },
 {
  "id": "fedora_live",
  "name": "Fedora live",
  "detect": [
   [
    "boot/x86_64/loader/linux",
    "boot/x86_64/loader/initrd"
   ],
   [
    "boot/aarch64/loader/linux",
    "boot/aarch64/loader/initrd"
   ]
  ],
  "label_prefix": "Fedora-",
  "kernel": "boot/{cpu}/loader/linux",
  "initrd": "boot/{cpu}/loader/initrd",
  "options": "iso-scan/filename={path} root=live:CDLABEL={label} rd.live.image"
 },
 {
  "id": "anaconda",
  "name": "Anaconda installer",
  "detect": [
   [
    "images/pxeboot/vmlinuz",
    "images/pxeboot/initrd.img",
    "images/install.img"
   ]
  ],
  "kernel": "images/pxeboot/vmlinuz",
  "initrd": "images/pxeboot/initrd.img",
  "options": "inst.stage2=hd:LABEL={label} bonk.offset={offset} ro",
  "location": true,
  "initrd_extra": "newc:etc/udev/rules.d/99-bonk-vault-iso.rules:{bonk}/udev/99-bonk-vault-iso.rules"
 },
 {
  "id": "mint",
  "name": "Linux Mint",
  "detect": [
   [
    "casper/vmlinuz",
    "casper/initrd.lz"
   ]
  ],
  "kernel": "casper/vmlinuz",
  "initrd": "casper/initrd.lz",
  "options": "boot=casper username=mint hostname=mint bonk.offset={offset}",
  "location": true,
  "initrd_extra": "newc:scripts/casper-premount/20iso_scan:{bonk}/casper/20iso_scan"
 },
 {
  "id": "garuda",
  "name": "Garuda Linux",
  "detect": [
   [
    "boot/vmlinuz-x86_64",
    "boot/initramfs-x86_64.img",
    "garuda/x86_64/rootfs.sfs"
   ]
  ],
  "kernel": "boot/vmlinuz-x86_64",
  "initrd": "boot/initramfs-x86_64.img",
  "options": "misobasedir=garuda root=miso:LABEL={label} rd.driver.pre=loop bonk.offset={offset}",
  "location": true,
  "initrd_extra": "newc:etc/udev/rules.d/99-bonk-vault-iso.rules:{bonk}/udev/99-bonk-vault-iso.rules"
 },
 {
  "id": "manjaro",
  "name": "Manjaro",
  "detect": [
   [
    "boot/vmlinuz-x86_64",
    "boot/initramfs-x86_64.img",
    "manjaro/x86_64/rootfs.sfs"
   ]
  ],
  "kernel": "boot/vmlinuz-x86_64",
  "initrd": "boot/initramfs-x86_64.img",
  "options": "misobasedir=manjaro misolabel={label} img_label={vault} img_loop={path}"
 },
 {
  "id": "openmandriva",
  "name": "OpenMandriva",
  "detect": [
   [
    "boot/vmlinuz0",
    "boot/liveinitrd.img",
    "LiveOS/squashfs.img"
   ]
  ],
  "kernel": "boot/vmlinuz0",
  "initrd": "boot/liveinitrd.img",
  "options": "root=live:LABEL={label} rd.live.image bonk.offset={offset}",
  "location": true,
  "initrd_extra": "newc:etc/udev/rules.d/99-bonk-vault-iso.rules:{bonk}/udev/99-bonk-vault-iso.rules"
 },
 {
  "id": "mageia",
  "name": "Mageia Live",
  "detect": [
   [
    "boot/vmlinuz",
    "boot/initrd.img",
    "loopbacks/distrib.sqfs"
   ]
  ],
  "kernel": "boot/vmlinuz",
  "initrd": "boot/initrd.img",
  "options": "root=mgalive:LABEL={label} bonk.offset={offset}",
  "location": true,
  "initrd_extra": "newc:etc/udev/rules.d/99-bonk-vault-iso.rules:{bonk}/udev/99-bonk-vault-iso.rules"
 },
 {
  "id": "agama",
  "name": "openSUSE installer (Agama)",
  "detect": [
   [
    "boot/x86_64/loader/linux",
    "boot/x86_64/loader/initrd"
   ],
   [
    "boot/aarch64/loader/linux",
    "boot/aarch64/loader/initrd"
   ]
  ],
  "label_prefix": "Install-",
  "kernel": "boot/{cpu}/loader/linux",
  "initrd": "boot/{cpu}/loader/initrd",
  "options": "iso-scan/filename={path} root=live:CDLABEL={label} rd.live.image"
 },
 {
  "id": "livemedia",
  "name": "Fedora-based live",
  "detect": [
   [
    "boot/vmlinuz",
    "boot/initramfs.img",
    "LiveOS/squashfs.img"
   ]
  ],
  "kernel": "boot/vmlinuz",
  "initrd": "boot/initramfs.img",
  "options": "iso-scan/filename={path} root=live:CDLABEL={label} rd.live.image"
 },
 {
  "id": "antix",
  "name": "antiX and MX Linux",
  "detect": [
   [
    "antiX/vmlinuz",
    "antiX/initrd.gz",
    "antiX/linuxfs"
   ]
  ],
  "kernel": "antiX/vmlinuz",
  "initrd": "antiX/initrd.gz",
  "options": "blab={vault} fromiso={path}"
 },
 {
  "id": "casper_gz",
  "name": "Ubuntu-based live (casper)",
  "detect": [
   [
    "casper/vmlinuz",
    "casper/initrd.gz"
   ]
  ],
  "kernel": "casper/vmlinuz",
  "initrd": "casper/initrd.gz",
  "options": "boot=casper bonk.offset={offset}",
  "location": true,
  "initrd_extra": "newc:scripts/casper-premount/20iso_scan:{bonk}/casper/20iso_scan"
 },
 {
  "id": "fedora_lorax",
  "name": "Fedora live (lorax)",
  "detect": [
   [
    "images/pxeboot/vmlinuz",
    "images/pxeboot/initrd.img",
    "LiveOS/squashfs.img"
   ]
  ],
  "kernel": "images/pxeboot/vmlinuz",
  "initrd": "images/pxeboot/initrd.img",
  "options": "iso-scan/filename={path} root=live:CDLABEL={label} rd.live.image"
 }
]
